# Append-only config for ramips_mt7621 (CR660x / Redmi AX1800 family)
# This file is appended to devices/common/.config at build time.
# Last key wins for duplicates.

# Restrict build to ONLY ramips_mt7621 (single profile) — without this,
# CONFIG_TARGET_ALL_PROFILES=y from common/.config would try to build
# every platform (~140+ profiles) and exceed the 6h Actions timeout.
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_MULTI_PROFILE=y

# Our target / device profile
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_xiaomi_redmi-router-ax1800=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_redmi-router-ax1800=y

# Disable platforms we don't need (lower kernel/build pressure)
# CFG_TGT_NOT_IN(_any of the other platforms_)=n can be added selectively,
# but selecting our target above is sufficient: make won't build
# unselected platforms when CONFIG_TARGET_ALL_PROFILES=n.

# Custom firmware metadata
CONFIG_VERSION_MANUFACTURER="xuanyuanxxs"
CONFIG_VERSION_REPO="https://dl.openwrt.ai/releases/25.12"
CONFIG_VERSION_DIST="Kwrt"
CONFIG_VERSION_NUMBER="25.12.0"

# User-requested packages (defense-in-depth: even if kiddin9/op-packages
# feed changes, these explicit selects ensure they're compiled in).
# All of these are confirmed present in opkg list-installed of source router.
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-shadowsocks-libev=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-advancedplus=y
CONFIG_PACKAGE_luci-app-syscontrol=y
CONFIG_PACKAGE_luci-app-fan=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wizard=y
CONFIG_PACKAGE_luci-app-wifihistory=y
CONFIG_PACKAGE_luci-theme-argon=y

# Common keto packages
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_kmod-ipt-ipset=y

# WiFi / 802.11s support (for mesh / repeater scenarios)
# Already in common defconfig, kept here for explicit tracking.
# CONFIG_PACKAGE_wpad-basic-mbedtls=y
# CONFIG_PACKAGE_wpad-wolfssl=m

# Compiler / size optimizations
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
